# 로컬에서는 이 파일을 `.env`로 복사한 뒤 실제 PostgreSQL 정보를 입력하세요.
# `.env`는 Git에 올라가지 않습니다.
DATABASE_URL=postgresql://postgres:password@localhost:5432/mcm_memory_tag

# SSL이 필요한 호스팅 PostgreSQL이라면 true로 변경하세요.
DATABASE_SSL=false

# 선택 사항: 서버 프로세스당 최대 PostgreSQL 연결 수
PGPOOL_MAX=5

# Kakao OAuth: Kakao Developers 앱의 REST API 키와 Client Secret을 입력하세요.
KAKAO_CLIENT_ID=example-kakao-rest-api-key
KAKAO_CLIENT_SECRET=example-kakao-client-secret

# OAuth 콘솔에 등록할 콜백 주소의 기준 URL입니다. 끝에 슬래시를 붙이지 마세요.
# Kakao:  http://localhost:3000/api/auth/oauth/kakao/callback
APP_BASE_URL=http://localhost:3000

# AI 도슨트(작품 질의응답) 기능에 사용하는 OpenAI API 키입니다.
OPEN_API=example-openai-api-key

# 선택 사항: AI 도슨트와 취향 리포트에 사용할 기본 텍스트 모델
OPENAI_MODEL=gpt-5-mini

# 선택 사항: 시간차 콘텐츠(관람 요약·편지)에 사용할 텍스트 모델
OPENAI_CONTENT_MODEL=gpt-5-mini

# 선택 사항: 전시 스티커 시트 생성·편집에 사용할 이미지 모델
OPENAI_IMAGE_MODEL=gpt-image-2
